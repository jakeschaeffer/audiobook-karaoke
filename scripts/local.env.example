# Copy to scripts/local.env (gitignored). What the scripts need to know about your accounts and
# servers; docs/SELF-HOSTING.md walks through each one. Nothing in here is a secret, and the App Store
# key itself stays at ~/.appstoreconnect/private_keys/AuthKey_<id>.p8.

# ---- scripts/testflight.sh and scripts/asc.mjs (only if you ship through TestFlight)
TEAM_ID=YOURTEAMID            # Apple Developer team, as in Local.xcconfig's DEVELOPMENT_TEAM
APP_BUNDLE_ID=com.example.AudioBS   # $(ORG_IDENTIFIER).AudioBS, from Local.xcconfig
ASC_KEY_ID=YOURKEYID          # App Store Connect → Users and Access → Integrations
ASC_ISSUER=00000000-0000-0000-0000-000000000000

# ---- scripts/smoke-play.sh
# An audiobook on your Audiobookshelf that streams. Use a test user's progress, not your own.
SMOKE_BOOK=
# Your daemon's /status, if it has a speaker. The test refuses to run unless the speaker is idle,
# because a session that advances pauses the speaker. Leave empty with no speaker.
SMOKE_DAEMON_STATUS=
